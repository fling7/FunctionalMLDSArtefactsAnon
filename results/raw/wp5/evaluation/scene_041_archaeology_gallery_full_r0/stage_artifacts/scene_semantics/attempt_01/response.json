          "text": "{\n  \"agent_role_candidates\": [\n    {\n      \"display_name\": \"Galerie-Guide\",\n      \"expertise\": [\"Archäologie\", \"Museumspädagogik\", \"Objekterklärung\"],\n      \"grounded_object_ids\": [\n        \"object_001\", \"object_002\", \"object_003\", \"object_004\", \"object_005\", \"object_006\", \"object_007\", \"object_008\", \"object_009\", \"object_010\", \"object_011\", \"object_012\", \"object_013\", \"object_014\", \"object_015\", \"object_016\", \"object_017\", \"object_018\", \"object_019\", \"object_020\", \"object_021\", \"object_022\", \"object_023\", \"object_024\", \"object_025\", \"object_026\", \"object_027\", \"object_028\", \"object_029\", \"object_030\", \"object_031\", \"object_032\", \"object_033\", \"object_034\", \"object_035\", \"object_036\", \"object_037\", \"object_038\", \"object_039\", \"object_040\", \"object_041\", \"object_042\", \"object_043\", \"object_044\", \"object_045\", \"object_046\", \"object_047\", \"object_048\", \"object_049\", \"object_050\", \"object_051\", \"object_052\", \"object_053\", \"object_054\", \"object_055\", \"object_056\", \"object_057\", \"object_058\", \"object_059\", \"object_060\", \"object_061\", \"object_062\", \"object_063\", \"object_064\", \"object_065\", \"object_066\", \"object_067\", \"object_068\", \"object_069\", \"object_070\", \"object_071\", \"object_072\", \"object_073\", \"object_074\", \"object_075\", \"object_076\", \"object_077\", \"object_078\", \"object_079\", \"object_080\"\n      ],\n      \"mission\": \"Führt Besucher durch die Galerie, erklärt die Exponate und gibt Hintergrundinformationen zu archäologischen Funden und Methoden.\",\n      \"responsible_zone_ids\": [\"zone_1\", \"zone_2\", \"zone_3\"],\n      \"role_id\": \"role_guide\"\n    },\n    {\n      \"display_name\": \"Sammlungs-Experte\",\n      \"expertise\": [\"Fachwissen zu spezifischen Sammlungen\", \"Detailfragen\", \"Forschung\"],\n      \"grounded_object_ids\": [\n        \"object_001\", \"object_004\", \"object_007\", \"object_010\", \"object_013\", \"object_016\", \"object_019\", \"object_022\", \"object_025\", \"object_028\", \"object_031\", \"object_034\", \"object_037\", \"object_040\", \"object_043\", \"object_046\", \"object_049\", \"object_052\", \"object_055\", \"object_058\", \"object_061\", \"object_064\", \"object_067\", \"object_070\", \"object_073\", \"object_076\", \"object_079\"\n      ],\n      \"mission\": \"Beantwortet vertiefende Fragen zu den einzelnen Sammlungen (z.B. Datierung, Siedlungskarten, Werkzeuge) und erläutert wissenschaftliche Hintergründe.\",\n      \"responsible_zone_ids\": [\"zone_1\"],\n      \"role_id\": \"role_collection_expert\"\n    },\n    {\n      \"display_name\": \"Interaktiver Vermittler\",\n      \"expertise\": [\"Besucherinteraktion\", \"Didaktik\", \"Nutzerführung\"],\n      \"grounded_object_ids\": [\n        \"object_001\", \"object_002\", \"object_003\", \"object_004\", \"object_005\", \"object_006\"\n      ],\n      \"mission\": \"Unterstützt Besucher bei der Nutzung interaktiver Stationen und fördert das eigenständige Erkunden der Exponate.\",\n      \"responsible_zone_ids\": [\"zone_1\", \"zone_2\", \"zone_3\"],\n      \"role_id\": \"role_interactive_mediator\"\n    }\n  ],\n  \"domain\": \"Archäologie, Museum, Ausstellung\",\n  \"important_objects\": [\n    {\n      \"object_id\": \"object_001\",\n      \"reason\": \"Startpunkt einer Sammlung, didaktisch zentrale Dating-Station.\"\n    },\n    {\n      \"object_id\": \"object_002\",\n      \"reason\": \"Zentrale Mosaiktafel, repräsentiert Sammlung 2.\"\n    },\n    {\n      \"object_id\": \"object_003\",\n      \"reason\": \"Werkzeugvitrine, Einstieg in Sammlung 3.\"\n    },\n    {\n      \"object_id\": \"object_041\",\n      \"reason\": \"Zentral im Raum, Pottery Display als Blickfang und didaktischer Knotenpunkt.\"\n    }\n  ],\n  \"interaction_topics\": [\n    {\n      \"description\": \"Erklärung der Methoden zur Datierung archäologischer Funde anhand der Dating Stations.\",\n      \"related_object_ids\": [\n        \"object_001\", \"object_007\", \"object_013\", \"object_019\", \"object_025\", \"object_031\", \"object_037\", \"object_043\", \"object_049\", \"object_055\", \"object_061\", \"object_067\", \"object_073\", \"object_079\"\n      ],\n      \"title\": \"Archäologische Datierung\",\n      \"topic_id\": \"topic_dating\"\n    },\n    {\n      \"description\": \"Bedeutung und Herstellung von Mosaiken in antiken Kulturen, illustriert durch die Mosaik Panels.\",\n      \"related_object_ids\": [\n        \"object_002\", \"object_008\", \"object_014\", \"object_020\", \"object_026\", \"object_032\", \"object_038\", \"object_044\", \"object_050\", \"object_056\", \"object_062\", \"object_068\", \"object_074\", \"object_080\"\n      ],\n      \"title\": \"Mosaikkunst der Antike\",\n      \"topic_id\": \"topic_mosaic\"\n    },\n    {\n      \"description\": \"Werkzeuge und Techniken der Ausgrabung, dargestellt durch Tool Cases und Excavation Models.\",\n      \"related_object_ids\": [\n        \"object_003\", \"object_009\", \"object_015\", \"object_021\", \"object_027\", \"object_033\", \"object_039\", \"object_045\", \"object_051\", \"object_057\", \"object_063\", \"object_069\", \"object_075\",\n        \"object_006\", \"object_012\", \"object_018\", \"object_024\", \"object_030\", \"object_036\", \"object_042\", \"object_048\", \"object_054\", \"object_060\", \"object_066\", \"object_072\", \"object_078\"\n      ],\n      \"title\": \"Archäologische Werkzeuge und Ausgrabung\",\n      \"topic_id\": \"topic_tools_excavation\"\n    },\n    {\n      \"description\": \"Siedlungskarten als Zugang zur Rekonstruktion antiker Lebensräume.\",\n      \"related_object_ids\": [\n        \"object_004\", \"object_010\", \"object_016\", \"object_022\", \"object_028\", \"object_034\", \"object_040\", \"object_046\", \"object_052\", \"object_058\", \"object_064\", \"object_070\", \"object_076\"\n      ],\n      \"title\": \"Antike Siedlungen\",\n      \"topic_id\": \"topic_settlement\"\n    },\n    {\n      \"description\": \"Keramikfunde und ihre Bedeutung für die Alltagskultur.\",\n      \"related_object_ids\": [\n        \"object_005\", \"object_011\", \"object_017\", \"object_023\", \"object_029\", \"object_035\", \"object_041\", \"object_047\", \"object_053\", \"object_059\", \"object_065\", \"object_071\", \"object_077\"\n      ],\n      \"title\": \"Keramik in der Archäologie\",\n      \"topic_id\": \"topic_pottery\"\n    }\n  ],\n  \"room_purpose\": \"Ausstellung archäologischer Funde und Methoden",
