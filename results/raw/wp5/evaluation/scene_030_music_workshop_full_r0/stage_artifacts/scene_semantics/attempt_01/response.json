      "content": [
        {
          "annotations": [],
          "logprobs": [],
          "text": "{\n  \"agent_role_candidates\": [\n    {\n      \"display_name\": \"Musik-Workshop-Guide\",\n      \"expertise\": [\"Musikinstrumente\", \"Musikpädagogik\", \"Interaktive Demonstrationen\"],\n      \"grounded_object_ids\": [\n        \"object_001\", \"object_004\", \"object_007\", \"object_013\", \"object_019\", \"object_025\", \"object_031\", \"object_037\"\n      ],\n      \"mission\": \"Führt Besucher durch die verschiedenen Instrumentenstationen, erklärt Funktionsweise und Geschichte der Instrumente und unterstützt bei interaktiven Experimenten.\",\n      \"responsible_zone_ids\": [\"zone_1\", \"zone_2\", \"zone_3\"],\n      \"role_id\": \"agent_guide\"\n    },\n    {\n      \"display_name\": \"Interaktiver Musik-Experimentator\",\n      \"expertise\": [\"Musiktechnik\", \"Sound-Interaktion\", \"Didaktik\"],\n      \"grounded_object_ids\": [\n        \"object_003\", \"object_009\", \"object_015\", \"object_021\", \"object_027\", \"object_033\", \"object_039\"\n      ],\n      \"mission\": \"Leitet Besucher an, mit den Rhythmus-Konsolen zu experimentieren, erklärt technische Hintergründe und fördert kreatives Ausprobieren.\",\n      \"responsible_zone_ids\": [\"zone_3\"],\n      \"role_id\": \"agent_experiment\"\n    },\n    {\n      \"display_name\": \"Noten- und Musiktheorie-Experte\",\n      \"expertise\": [\"Musiktheorie\", \"Notenlesen\", \"Didaktik\"],\n      \"grounded_object_ids\": [\n        \"object_002\", \"object_008\", \"object_014\", \"object_020\", \"object_026\", \"object_032\", \"object_038\"\n      ],\n      \"mission\": \"Erklärt Besuchern die Bedeutung der Notenanzeigen und vermittelt Grundlagen der Musiktheorie.\",\n      \"responsible_zone_ids\": [\"zone_2\"],\n      \"role_id\": \"agent_theory\"\n    }\n  ],\n  \"domain\": \"Musikpädagogik, interaktives Lernen\",\n  \"important_objects\": [\n    {\n      \"object_id\": \"object_001\",\n      \"reason\": \"Windinstrument als exemplarisches Anschauungsobjekt für Besucherinteraktion und Erklärung.\"\n    },\n    {\n      \"object_id\": \"object_003\",\n      \"reason\": \"Rhythmus-Konsole als zentrales interaktives Element für musikalisches Experimentieren.\"\n    },\n    {\n      \"object_id\": \"object_002\",\n      \"reason\": \"Score Display zur Vermittlung von Musiktheorie und Notenlesen.\"\n    }\n  ],\n  \"interaction_topics\": [\n    {\n      \"description\": \"Besucher lernen verschiedene Instrumentengattungen kennen und dürfen diese ausprobieren.\",\n      \"related_object_ids\": [\n        \"object_001\", \"object_006\", \"object_012\", \"object_018\", \"object_024\", \"object_030\", \"object_036\"\n      ],\n      \"title\": \"Instrumentenvielfalt erleben\",\n      \"topic_id\": \"topic_instruments\"\n    },\n    {\n      \"description\": \"An den Rhythmus-Konsolen können Besucher Rhythmen erzeugen und Klangexperimente durchführen.\",\n      \"related_object_ids\": [\n        \"object_003\", \"object_009\", \"object_015\", \"object_021\", \"object_027\", \"object_033\", \"object_039\"\n      ],\n      \"title\": \"Rhythmus und Klang erforschen\",\n      \"topic_id\": \"topic_rhythm\"\n    },\n    {\n      \"description\": \"Die Score Displays bieten Einblicke in Notenschrift und Musiktheorie.\",\n      \"related_object_ids\": [\n        \"object_002\", \"object_008\", \"object_014\", \"object_020\", \"object_026\", \"object_032\", \"object_038\"\n      ],\n      \"title\": \"Musiktheorie und Notenlesen\",\n      \"topic_id\": \"topic_theory\"\n    }\n  ],\n  \"room_purpose\": \"Interaktiver Musik-Workshop zur Vermittlung von Instrumentenkunde, Musiktheorie und Klangexperimenten.\",\n  \"semantic_zones\": [\n    {\n      \"centroid_xz\": {\"x\": 0.0, \"z\": -0.4},\n      \"name\": \"Instrumenten-Zone\",\n      \"object_ids\": [\n        \"object_001\", \"object_004\", \"object_007\", \"object_013\", \"object_019\", \"object_025\", \"object_031\", \"object_037\",\n        \"object_006\", \"object_012\", \"object_018\", \"object_024\", \"object_030\", \"object_036\"\n      ],\n      \"purpose\": \"Präsentation und Interaktion mit verschiedenen Musikinstrumenten.\",\n      \"visitor_goals_supported\": [\n        \"Instrumente ausprobieren\",\n        \"Klangvielfalt erleben\"\n      ],\n      \"zone_id\": \"zone_1\"\n    },\n    {\n      \"centroid_xz\": {\"x\": -0.4308, \"z\": -0.5385},\n      \"name\": \"Theorie- und Noten-Zone\",\n      \"object_ids\": [\n        \"object_002\", \"object_008\", \"object_014\", \"object_020\", \"object_026\", \"object_032\", \"object_038\"\n      ],\n      \"purpose\": \"Vermittlung von Musiktheorie und Notenlesen.\",\n      \"visitor_goals_supported\": [\n        \"Notenlesen lernen\",\n        \"Musiktheorie verstehen\"\n      ],\n      \"zone_id\": \"zone_2\"\n    },\n    {\n      \"centroid_xz\": {\"x\": -0.6462, \"z\": -0.1077},\n      \"name\": \"Rhythmus- und Experimentier-Zone\",\n      \"object_ids\": [\n        \"object_003\", \"object_009\", \"object_015\", \"object_021\", \"object_027\", \"object_033\", \"object_039\"\n      ],\n      \"purpose\": \"Interaktives Experimentieren mit Rhythmus und Klang.\",\n      \"visitor_goals_supported\": [\n        \"Rhythmen erzeugen\",\n        \"Klangexperimente durchführen\"\n      ],\n      \"zone_id\": \"zone_3\"\n    }\n  ],\n  \"visitor_goals\": [\n    \"Instrumente ausprobieren\",\n    \"Klangvielfalt erleben\",\n    \"Notenlesen lernen\",\n    \"Musiktheorie verstehen\",\n    \"Rhythmen erzeugen\",\n    \"Klangexperimente durchführen\"\n  ]\n}",
