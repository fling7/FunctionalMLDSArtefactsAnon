          "text": "{\n  \"agent_role_candidates\": [\n    {\n      \"display_name\": \"Astronomie-Galerie Guide\",\n      \"expertise\": [\n        \"Astronomie\",\n        \"Vermittlung wissenschaftlicher Exponate\",\n        \"Besucherführung\"\n      ],\n      \"grounded_object_ids\": [\n        \"object_001\",\n        \"object_002\",\n        \"object_003\",\n        \"object_004\",\n        \"object_005\",\n        \"object_006\",\n        \"object_007\",\n        \"object_008\",\n        \"object_009\",\n        \"object_010\",\n        \"object_011\",\n        \"object_012\",\n        \"object_013\",\n        \"object_014\",\n        \"object_015\",\n        \"object_016\",\n        \"object_017\",\n        \"object_018\",\n        \"object_019\",\n        \"object_020\",\n        \"object_021\",\n        \"object_022\",\n        \"object_023\",\n        \"object_024\",\n        \"object_025\",\n        \"object_026\",\n        \"object_027\",\n        \"object_028\",\n        \"object_029\",\n        \"object_030\",\n        \"object_031\",\n        \"object_032\",\n        \"object_033\",\n        \"object_034\",\n        \"object_035\",\n        \"object_036\",\n        \"object_037\",\n        \"object_038\",\n        \"object_039\",\n        \"object_040\",\n        \"object_041\",\n        \"object_042\",\n        \"object_043\",\n        \"object_044\",\n        \"object_045\",\n        \"object_046\",\n        \"object_047\",\n        \"object_048\",\n        \"object_049\",\n        \"object_050\",\n        \"object_051\",\n        \"object_052\",\n        \"object_053\",\n        \"object_054\",\n        \"object_055\",\n        \"object_056\",\n        \"object_057\",\n        \"object_058\",\n        \"object_059\",\n        \"object_060\",\n        \"object_061\",\n        \"object_062\",\n        \"object_063\",\n        \"object_064\",\n        \"object_065\",\n        \"object_066\",\n        \"object_067\",\n        \"object_068\",\n        \"object_069\",\n        \"object_070\",\n        \"object_071\",\n        \"object_072\",\n        \"object_073\",\n        \"object_074\",\n        \"object_075\",\n        \"object_076\",\n        \"object_077\",\n        \"object_078\",\n        \"object_079\",\n        \"object_080\"\n      ],\n      \"mission\": \"Führt Besucher durch die Astronomie-Galerie, erklärt die Exponate und beantwortet Fragen zu astronomischen Themen.\",\n      \"responsible_zone_ids\": [\n        \"zone_collection_1\",\n        \"zone_collection_2\",\n        \"zone_collection_3\"\n      ],\n      \"role_id\": \"gallery_guide\"\n    },\n    {\n      \"display_name\": \"Interaktiver Lernassistent\",\n      \"expertise\": [\n        \"Didaktik\",\n        \"Interaktive Vermittlung\",\n        \"Astronomische Experimente\"\n      ],\n      \"grounded_object_ids\": [\n        \"object_006\",\n        \"object_012\",\n        \"object_018\",\n        \"object_024\",\n        \"object_030\",\n        \"object_036\",\n        \"object_042\",\n        \"object_048\",\n        \"object_054\",\n        \"object_060\",\n        \"object_066\",\n        \"object_072\",\n        \"object_078\"\n      ],\n      \"mission\": \"Unterstützt Besucher bei der Nutzung interaktiver Exponate wie Orbit-Simulatoren und fördert das praktische Lernen.\",\n      \"responsible_zone_ids\": [\n        \"zone_collection_3\"\n      ],\n      \"role_id\": \"learning_assistant\"\n    }\n  ],\n  \"domain\": \"Astronomie, Wissenschaftskommunikation, Ausstellung\",\n  \"important_objects\": [\n    {\n      \"object_id\": \"object_004\",\n      \"reason\": \"Teleskop als zentrales astronomisches Instrument, häufiges Besucherinteresse.\"\n    },\n    {\n      \"object_id\": \"object_006\",\n      \"reason\": \"Orbit-Simulator als interaktives, didaktisch wertvolles Exponat.\"\n    },\n    {\n      \"object_id\": \"object_002\",\n      \"reason\": \"Planetenmodell als anschauliches Objekt für die Vermittlung astronomischer Zusammenhänge.\"\n    },\n    {\n      \"object_id\": \"object_003\",\n      \"reason\": \"Meteoriten-Display als Beispiel für extraterrestrisches Material.\"\n    }\n  ],\n  \"interaction_topics\": [\n    {\n      \"description\": \"Wie funktioniert ein Teleskop und was kann man damit beobachten?\",\n      \"related_object_ids\": [\n        \"object_004\",\n        \"object_010\",\n        \"object_016\",\n        \"object_022\",\n        \"object_028\",\n        \"object_034\",\n        \"object_040\",\n        \"object_046\",\n        \"object_052\",\n        \"object_058\",\n        \"object_064\",\n        \"object_070\",\n        \"object_076\"\n      ],\n      \"title\": \"Teleskope und ihre Nutzung\",\n      \"topic_id\": \"topic_telescopes\"\n    },\n    {\n      \"description\": \"Planetenmodelle als Hilfsmittel zum Verständnis des Sonnensystems.\",\n      \"related_object_ids\": [\n        \"object_002\",\n        \"object_008\",\n        \"object_014\",\n        \"object_020\",\n        \"object_026\",\n        \"object_032\",\n        \"object_038\",\n        \"object_044\",\n        \"object_050\",\n        \"object_056\",\n        \"object_062\",\n        \"object_068\",\n        \"object_074\",\n        \"object_080\"\n      ],\n      \"title\": \"Planetenmodelle und das Sonnensystem\",\n      \"topic_id\": \"topic_planet_models\"\n    },\n    {\n      \"description\": \"Meteoriten als Zeugnisse aus dem All und ihre wissenschaftliche Bedeutung.\",\n      \"related_object_ids\": [\n        \"object_003\",\n        \"object_009\",\n        \"object_015\",\n        \"object_021\",\n        \"object_027\",\n        \"object_033\",\n        \"object_039\",\n        \"object_045\",\n        \"object_051\",\n        \"object_057\",\n        \"object_063\",\n        \"object_069\",\n        \"object_075\"\n      ],\n      \"title\": \"Meteoriten und extraterrestrische Materie\",\n      \"topic_id\": \"topic_meteorites\"\n    },\n    {\n      \"description\": \"Orbit-Simulatoren als interaktive Lernstationen für Planetenbewegungen.\",\n      \"related_object_ids\": [\n        \"object_006\",\n        \"object_012\",\n        \"object_018\",\n        \"object_024\",\n        \"object_030\",\n        \"object_036\",\n        \"object_042\",\n        \"object_048\",\n        \"object_054\",\n        \"object_060\",\n        \"object_066\",\n        \"object_072\",\n        \"object_078\"\n      ],\n      \"title\": \"Interaktive Orbit-Simulation\",\n      \"topic_id\": \"topic_orbit_sim\"\n    }\n  ],\n  \"room_purpose\": \"Wissenschaftliche Ausstellung zur Vermittlung astronomischer Inhalte für ein breites Publikum.\",\n  \"semantic_zones\": [\n    {\n      \"centroid_xz\": {\n        \"x\": -2.8,\n        \"z\": 0.0\n      },\n      \"name\": \"Zone Sammlung 1: Teleskope & Spektroskope\",\n      \"object_ids\": [\n        \"object_001\",\n        \"object_004\",\n        \"object_007\",\n        \"object_010\",\n        \"object_013\",\n        \"object_016\",\n        \"object_019\",\n        \"object_022\",\n        \"object_025\",\n        \"object_028\",\n        \"object_031\",\n        \"object_034\",\n        \"object_037\",\n        \"object_040\",\n        \"object_043\",\n        \"object_046\",\n        \"object_049\",\n        \"object_052\",\n        \"object_055\",\n        \"object_058\",\n        \"object_061\",\n        \"object_064\",\n        \"object_067\",\n        \"object_070\",\n        \"object_073\",\n        \"object_076\",\n        \"object_079\"\n      ],\n      \"purpose\": \"Präsentation optischer Instrumente zur Himmelsbeobachtung und Spektralanalyse",
