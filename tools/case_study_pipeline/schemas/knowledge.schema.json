{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneratedKnowledgeBase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_entries"
  ],
  "properties": {
    "knowledge_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "name",
          "source_object_ids",
          "text",
          "intended_agents"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "intended_agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
