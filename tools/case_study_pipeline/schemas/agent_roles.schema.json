{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRoles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agents",
    "handoffs"
  ],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "persona",
          "expertise",
          "knowledge_tags",
          "responsible_zone_ids",
          "grounded_object_ids",
          "handoff_targets",
          "voice",
          "voice_gender",
          "voice_style",
          "tts_model"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "expertise": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responsible_zone_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grounded_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoff_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "voice": {
            "type": "string"
          },
          "voice_gender": {
            "type": "string"
          },
          "voice_style": {
            "type": "string"
          },
          "tts_model": {
            "type": "string"
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_agent_id",
          "target_agent_id",
          "condition",
          "reason"
        ],
        "properties": {
          "source_agent_id": {
            "type": "string"
          },
          "target_agent_id": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
